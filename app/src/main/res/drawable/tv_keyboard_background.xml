<?xml version="1.0" encoding="utf-8"?>
<!-- Glass panel for the full TV keyboard (top sheet, sits at the top of the screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4D000000" />
            <corners
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="22dp" />
        </shape>
    </item>
    <!-- dark translucent glass body -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F20D1622"
                android:endColor="#F2070D16"
                android:angle="270" />
            <corners
                android:bottomLeftRadius="22dp"
                android:bottomRightRadius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
