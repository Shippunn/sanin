<?xml version="1.0" encoding="utf-8"?>
<!-- Red-tinted glass surface for destructive keys (full keyboard). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#59FF6B6B"
                android:endColor="#12FF6B6B"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#40FF6B6B" />
        </shape>
    </item>
</layer-list>
