<?xml version="1.0" encoding="utf-8"?>
<!-- Default glass key surface (full keyboard). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft drop shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- translucent glass body with thin highlight border -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#59FFFFFF"
                android:endColor="#12FFFFFF"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
