<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:baselineAligned="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- Left 70% - Comment Carousel -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusDown="@id/commentsList"
        android:nextFocusUp="@id/commentsList">

        <FrameLayout
            android:id="@+id/commentsProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_colorFilter="?attr/colorSecondary"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/tomoe"
                app:lottie_speed="1.75" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:nextFocusUp="@id/commentsList"
            android:nextFocusDown="@id/commentsList"
            android:descendantFocusability="blocksDescendants"
            android:visibility="visible"
            tools:listitem="@layout/item_comment_carousel"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/commentsOfflineText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="You need an internet connection to use comments"
            android:textColor="#FF888888"
            android:textSize="18sp"
            android:visibility="gone" />

        <View
            android:id="@+id/commentsDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#FF2A2A2A" />
    </FrameLayout>

    <!-- Right 30% - Info Panel -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="?attr/colorSurface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Cover Poster (media.cover) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/commentsPoster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:nextFocusLeft="@id/commentsList"
                tools:ignore="ContentDescription" />

            <!-- Logo / Title -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/commentsLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:nextFocusLeft="@id/commentsList"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="Anime Title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <!-- List Editor Button -->
            <Button
                android:id="@+id/commentsListEditor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:nextFocusLeft="@id/commentsList"
                android:padding="4dp"
                android:text="@string/add_list"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="?attr/colorOnSurface" />

            <!-- Episode Progress Badge + Sort + Rules Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/commentCurrentProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:background="@drawable/btn_transparent_round"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:text="Ep 1"
                    android:textColor="#FFAAAAAA"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/commentClearFilter"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear filter"
                    android:src="@drawable/ic_round_close_24"
                    android:visibility="gone"
                    app:tint="#FFAAAAAA"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/commentSort"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sort_by"
                    android:nextFocusLeft="@id/commentsList"
                    app:srcCompat="@drawable/ic_round_sort_24"
                    app:tint="#FF888888" />

                <ImageView
                    android:id="@+id/openRules"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/open_rules"
                    android:nextFocusLeft="@id/commentsList"
                    app:srcCompat="@drawable/ic_round_info_24"
                    app:tint="#FF888888" />
            </LinearLayout>

            <!-- Input -->
            <LinearLayout
                android:id="@+id/commentMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="visible"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/commentReplyToContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/commentReplyTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:singleLine="true"
                        android:text="Replying to user"
                        android:textColor="#FFBB86FC"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:id="@+id/commentReplyToCancel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_round_close_24"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commentInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/commentUserAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircularImageView"
                        app:srcCompat="@drawable/ic_round_add_circle_24"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/commentInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/poppins"
                        android:hint="Add a comment..."
                        android:inputType="textMultiLine"
                        android:maxLength="300"
                        android:maxLines="3"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#FF666666"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <ImageButton
                        android:id="@+id/commentGif"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:focusable="true"
                        android:padding="3dp"
                        android:src="@drawable/ic_round_gif_24"
                        android:visibility="gone"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/commentSpoiler"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:focusable="true"
                        android:padding="3dp"
                        android:src="@drawable/ic_round_remove_red_eye_24"
                        android:visibility="gone"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/commentLabel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/ic_label_off_24"
                        android:visibility="gone"
                        tools:ignore="ContentDescription"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/commentSend"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:nextFocusLeft="@id/commentsList"
                        android:nextFocusDown="@id/commentsList"
                        android:src="@drawable/ic_round_send_24"
                        android:visibility="gone"
                        app:tint="#FFBB86FC"
                        tools:ignore="ContentDescription"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
