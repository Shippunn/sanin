<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commentsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:baselineAligned="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="horizontal"
    android:padding="0dp">

    <!-- Left 70% - Comment Carousel -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:clipChildren="false"
        android:clipToPadding="false">

        <FrameLayout
            android:id="@+id/commentsProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"
            tools:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_colorFilter="?attr/colorSecondary"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/tomoe"
                app:lottie_speed="1.75" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="visible"
            tools:listitem="@layout/item_comment_carousel"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/commentsOfflineText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="You need an internet connection to use comments"
            android:textColor="#FF888888"
            android:textSize="18sp"
            android:visibility="gone" />

        <View
            android:id="@+id/commentsDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#FF2A2A2A" />
    </FrameLayout>

    <!-- Right 30% - Anime Info Panel -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="#FF000000"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Anime Poster -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/commentsPoster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.35"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCornerImage"
                app:srcCompat="@drawable/ic_round_movie_24"
                tools:ignore="ContentDescription" />

            <!-- Anime Title -->
            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="Anime Title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                tools:ignore="HardcodedText" />

            <!-- Episode Progress / List Status -->
            <TextView
                android:id="@+id/commentCurrentProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.6"
                android:background="@drawable/btn_transparent_round"
                android:focusable="true"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="Ep 1"
                android:textColor="#FFAAAAAA"
                android:textSize="13sp"
                android:visibility="visible"
                tools:ignore="HardcodedText" />

            <!-- Source Switch (Sanin / Trakt) -->
            <LinearLayout
                android:id="@+id/commentSourceBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="visible"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/commentSourceSanin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_transparent_round"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="Sanin"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/commentSourceTrakt"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_transparent_round"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="Trakt"
                    android:textColor="#FF888888"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Add Comment Box -->
            <LinearLayout
                android:id="@+id/commentMessageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/commentReplyToContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/commentReplyTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins"
                        android:singleLine="true"
                        android:text="Replying to user"
                        android:textColor="#FFBB86FC"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:id="@+id/commentReplyToCancel"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_round_close_24"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commentInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FF1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/commentUserAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircularImageView"
                        app:srcCompat="@drawable/ic_round_add_circle_24"
                        tools:ignore="ContentDescription" />

                    <EditText
                        android:id="@+id/commentInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/poppins"
                        android:hint="Add a comment..."
                        android:inputType="textMultiLine"
                        android:maxLength="300"
                        android:maxLines="3"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#FF666666"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <ImageButton
                        android:id="@+id/commentSend"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:focusable="true"
                        android:src="@drawable/ic_round_send_24"
                        app:tint="#FFBB86FC"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/commentGif"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_round_gif_24"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/commentSpoiler"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_round_remove_red_eye_24"
                        app:tint="#FF888888"
                        tools:ignore="ContentDescription" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
